<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" spacing="10.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <Label alignment="CENTER" contentDisplay="CENTER" text="Blue" textAlignment="CENTER" textFill="#004dff">
         <font>
            <Font name="Comic Sans MS Bold" size="25.0" />
         </font>
      </Label>
      <HBox alignment="CENTER" prefHeight="50.0" prefWidth="563.0">
         <children>
            <TextField promptText="Usuario" />
            <PasswordField promptText="Contraseña" />
            <Button mnemonicParsing="false" text="Registrar" />
            <Button mnemonicParsing="false" text="Actualizar" />
            <Separator orientation="VERTICAL" prefWidth="25.0">
               <opaqueInsets>
                  <Insets />
               </opaqueInsets></Separator>
            <TextField layoutX="10.0" layoutY="10.0" prefHeight="25.0" prefWidth="49.0" promptText="ID" />
            <Button mnemonicParsing="false" text="Eliminar" textFill="RED" />
         </children>
      </HBox>
      <TableView prefHeight="200.0" prefWidth="200.0">
        <columns>
          <TableColumn prefWidth="75.0" text="ID" />
          <TableColumn prefWidth="75.0" text="Usuario" />
            <TableColumn prefWidth="319.0" text="Datos" />
        </columns>
      </TableView>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</VBox>
