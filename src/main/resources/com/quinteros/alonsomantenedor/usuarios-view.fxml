<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" spacing="10.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.quinteros.alonsomantenedor.controller.UsuariosController">
   <children>

      <Label alignment="CENTER" contentDisplay="CENTER" text="Blue" textAlignment="CENTER" textFill="#004dff">
         <font>
            <Font name="Comic Sans MS Bold" size="25.0" />
         </font>
      </Label>
      <HBox alignment="CENTER" prefHeight="50.0" prefWidth="563.0">
         <children>
            <TextField fx:id="txtUsuario" promptText="Usuario" />
            <PasswordField fx:id="txtContrasena" promptText="Contraseña" />
            <Button fx:id="btnRegistrar" mnemonicParsing="false" onAction="#handleAgregarUsuario" text="Registrar" />
            <Button fx:id="btnActualizar" mnemonicParsing="false" text="Actualizar" />
            <Separator orientation="VERTICAL" prefWidth="25.0">
               <opaqueInsets>
                  <Insets />
               </opaqueInsets></Separator>
            <TextField fx:id="txtId" layoutX="10.0" layoutY="10.0" prefHeight="25.0" prefWidth="49.0" promptText="ID" />
            <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#handleEliminarUsuario" text="Eliminar" textFill="RED" />
         </children>
      </HBox>
      <TableView fx:id="tableUsuarios" onMouseClicked="#handleSeleccionar" prefHeight="200.0" prefWidth="200.0">
        <columns>
          <TableColumn fx:id="colId" prefWidth="75.0" text="ID" />
          <TableColumn fx:id="colUsuario" prefWidth="75.0" text="Usuario" />
            <TableColumn fx:id="colDatos" prefWidth="319.0" text="Datos" />
        </columns>
      </TableView>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</VBox>
